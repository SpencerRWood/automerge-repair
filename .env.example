# Non-secret settings. Credentials arrive via Infisical at deployment time.
AUTOMERGE_REPAIR_ENVIRONMENT=dev
AUTOMERGE_REPAIR_POLICY_FILE=config/policy.toml
# Offline durable store; deployment injects a protected PostgreSQL URL instead.
AUTOMERGE_REPAIR_INCIDENT_DATABASE_URL=sqlite:////tmp/automerge-repair-incidents.sqlite
DAGSTER_GRPC_PORT=4000
